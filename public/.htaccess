# ==========================================================================
# Aurigital — canonicalización de URLs (LiteSpeed / Apache)
#
# Vive en public/ para que `next build` lo copie a out/ en cada despliegue.
# Subí el out/ completo: si este archivo no llega al servidor, el sitio vuelve
# a servir cada página en 6 URLs distintas y Google se vuelve a confundir.
#
# Objetivo: UNA sola URL por página.
#   https://aurigital.com/sistema-web
# Todo lo demás (http, www, .html, barra final) redirige ahí en UN solo salto.
#
# OJO: si el servidor ya tiene un .htaccess con reglas de redirección (hoy
# redirige www → non-www solo en la raíz), hay que REEMPLAZAR esas reglas por
# estas, no apilarlas. Dos juegos de reglas = cadenas de redirects.
# ==========================================================================

# La negociación de contenido de Apache sirve archivos .html por su cuenta y se
# salta las reglas de abajo. Apagada para que el ruteo sea predecible.
Options -MultiViews

RewriteEngine On

# --------------------------------------------------------------------------
# 1. HTTPS + non-www, en un solo salto
#    Cubre TODAS las rutas, no solo la raíz (ese era el bug original).
#    Como el destino lleva el host final escrito, http://www.… llega a
#    https://aurigital.com/… en una sola redirección, sin cadena.
#
#    1a. Forzar HTTPS. Se consulta también X-Forwarded-Proto: si algún día el
#        sitio queda detrás de un proxy o CDN (Cloudflare), %{HTTPS} llega
#        apagado y sin esta condición se arma un bucle infinito de redirects.
# --------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://aurigital.com%{REQUEST_URI} [L,R=301]

#    1b. Forzar non-www (las peticiones que ya vienen en HTTPS).
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aurigital.com%{REQUEST_URI} [L,R=301]

# --------------------------------------------------------------------------
# 2. /index.html -> /
#    Tiene que ir ANTES de la regla genérica de .html, si no da /index.
# --------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [L,R=301]

# --------------------------------------------------------------------------
# 3. /ruta.html -> /ruta
#    Se evalúa contra THE_REQUEST (la petición original del navegador) y no
#    contra la URI reescrita. Sin esto, la regla 5 reescribe a .html y volvemos
#    a entrar acá: bucle de redirecciones.
# --------------------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# --------------------------------------------------------------------------
# 4. /ruta/ -> /ruta  (quitar la barra final)
#    Excluye directorios reales para no romper /assets/, /fonts/, etc.
# --------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/+$ /$1 [L,R=301]

# --------------------------------------------------------------------------
# 5. Servir /ruta desde ruta.html SIN redirigir (rewrite interno)
#    El export estático genera sistema-web.html; el usuario y Google ven
#    /sistema-web.
# --------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# --------------------------------------------------------------------------
# 6. Rutas retiradas
#    /ppm se eliminó del repo (era un duplicado exacto de /plan-paz-mental).
#    Este 301 evita que quien tenga el link viejo caiga en un 404.
#    Si preferís que dé 404, borrá estas dos líneas.
# --------------------------------------------------------------------------
RewriteRule ^ppm/?$ /plan-paz-mental [L,R=301]

# --------------------------------------------------------------------------
# 7. Página 404 propia
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# 8. Caché de assets estáticos
#    Los archivos con hash en el nombre (/_next/static/...) son inmutables.
#    El HTML NO se cachea, para que un despliegue se vea de inmediato.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType video/webm                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2|avif|webp|png|jpe?g|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
